# Local defaults; no external services needed.
PORT=3000
LOCAL_DB_DIR=./data/arena
ARENA_BACKUP_DIR=./data/backups

# Railway: reference Postgres DATABASE_URL. Migrations run automatically.
# DATABASE_URL=
# SQL_HOST=
# SQL_USER=
# SQL_PASSWORD=
# SQL_DB_NAME=

# Optional contact-form email; requires verified sender.
# RESEND_API_KEY=
# MAIL_FROM=

# Railway listens on 0.0.0.0 and uses RAILWAY_PUBLIC_DOMAIN for PUBLIC_ORIGIN.
# Other providers: HOST=0.0.0.0 and explicit PUBLIC_ORIGIN.
# PUBLIC_ORIGIN=https://your-domain.example
# ALLOW_SIGNUPS=false
